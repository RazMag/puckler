# Shared password that unlocks the Draft Room (editing picks).
CREW_PASSWORD=change-me
# Long random string used to sign the editor cookie: `openssl rand -base64 32`
SESSION_SECRET=
# Where crew.json is stored (defaults to ./data in dev, /data in the container).
# DATA_DIR=/data

# Optional: link full games Sportarr downloaded into Jellyfin.
# Create the key in Jellyfin under Dashboard → API Keys.
# JELLYFIN_URL=https://jellyfin.example.org
# JELLYFIN_API_KEY=
# Where browsers open Jellyfin, if not at JELLYFIN_URL (say Puckler reaches it by an internal address).
# JELLYFIN_PUBLIC_URL=
# The series Sportarr files NHL games under (defaults to NHL).
# JELLYFIN_SERIES=NHL
